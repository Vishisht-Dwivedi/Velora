+static int get_rx_queue_count(int ifindex, uint32_t *queue_count)
+{
+        struct {
+                struct nlmsghdr header;
+                struct ifinfomsg interface;
+        } request = { 0 };
+        struct sockaddr_nl address = { .nl_family = AF_NETLINK };
+        char response[4096];
+        ssize_t length;
+        int fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+
+        if (fd < 0)
+                return -1;
+
+        request.header.nlmsg_len = NLMSG_LENGTH(sizeof(request.interface));
+        request.header.nlmsg_type = RTM_GETLINK;
+        request.header.nlmsg_flags = NLM_F_REQUEST;
+        request.header.nlmsg_seq = 1;
+        request.interface.ifi_family = AF_UNSPEC;
+        request.interface.ifi_index = ifindex;
+        if (sendto(fd, &request, request.header.nlmsg_len, 0,
+                   (struct sockaddr *)&address, sizeof(address)) < 0) {
+                close(fd);
+                return -1;
+        }
+
+        length = recv(fd, response, sizeof(response), 0);
+        close(fd);
+        if (length < 0)
+                return -1;
+
+        for (struct nlmsghdr *header = (struct nlmsghdr *)response;
+             NLMSG_OK(header, (unsigned int)length);
+             header = NLMSG_NEXT(header, length)) {
+                struct ifinfomsg *interface;
+                struct rtattr *attribute;
+                int remaining;
+
+                if (header->nlmsg_type == NLMSG_ERROR) {
+                        errno = EPROTO;
+                        return -1;
+                }
+                if (header->nlmsg_type != RTM_NEWLINK)
+                        continue;
+                interface = NLMSG_DATA(header);
+                if (interface->ifi_index != ifindex)
+                        continue;
+
+                remaining = IFLA_PAYLOAD(header);
+                for (attribute = IFLA_RTA(interface);
+                     RTA_OK(attribute, remaining);
+                     attribute = RTA_NEXT(attribute, remaining)) {
+                        if (attribute->rta_type == IFLA_NUM_RX_QUEUES &&
+                            RTA_PAYLOAD(attribute) >= sizeof(*queue_count)) {
+                                memcpy(queue_count, RTA_DATA(attribute),
+                                       sizeof(*queue_count));
+                                return 0;
+                        }
+                }
+                errno = ENODATA;
+                return -1;
+        }
+
+        errno = ENODEV;
+        return -1;
+}
