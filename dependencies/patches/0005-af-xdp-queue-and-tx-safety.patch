+#ifndef AFXDP_PACKET_IO_H
+#define AFXDP_PACKET_IO_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <bpf/xsk.h>
+
+static inline int afxdp_single_rx_queue_supported(uint32_t rx_queue_count,
+                                                   uint32_t queue_id,
+                                                   uint32_t xskmap_entries)
+{
+        return rx_queue_count == 1 && queue_id == 0 &&
+               queue_id < xskmap_entries;
+}
+
+/* libbpf reserve is all-or-nothing; keep the batch intact if it fails. */
+static inline size_t afxdp_tx_submit_pending(struct xsk_ring_prod *tx,
+                                              const uint64_t *addrs,
+                                              const uint64_t *lens,
+                                              size_t pending_count)
+{
+        uint32_t index;
+        size_t reserved;
+
+        if (pending_count == 0)
+                return 0;
+
+        reserved = xsk_ring_prod__reserve(tx, pending_count, &index);
+        if (reserved != pending_count)
+                return 0;
+
+        for (size_t packet = 0; packet < reserved; packet++) {
+                struct xdp_desc *desc = xsk_ring_prod__tx_desc(tx, index++);
+                desc->addr = addrs[packet];
+                desc->len = (__u32)lens[packet];
+                desc->options = 0;
+        }
+
+        xsk_ring_prod__submit(tx, reserved);
+        return reserved;
+}
+
+#endif
